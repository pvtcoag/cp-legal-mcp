# ─── Auth ────────────────────────────────────────────────────────────────────
# Comma-separated user:token pairs. Generate tokens with: openssl rand -base64 32
# Adding a new user = add another pair here and redeploy. No code changes needed.
MCP_AUTH_TOKENS=admin:TOKEN_ADMIN,analyst:TOKEN_ANALYST

# Comma-separated users permitted to use admin tools (inspect_database etc.)
ADMIN_USERS=admin

# ─── AusLaw MCP upstream ─────────────────────────────────────────────────────
# In Railway use the reference variable: http://${{auslaw-mcp.RAILWAY_PRIVATE_DOMAIN}}:3000
AUSLAW_BASE_URL=http://localhost:3000
AUSLAW_TIMEOUT_MS=30000

# ─── HuggingFace Inference API ───────────────────────────────────────────────
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_ENABLED=true
HF_RERANK_MODEL=isaacus/emubert
HF_RERANK_TOP_K=10

# ─── Matter tracking (PostgreSQL) ────────────────────────────────────────────
# In Railway use the reference variable: ${{Postgres.DATABASE_URL}}
# Leave unset to disable matter tracking (service continues to work without it)
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# ─── OAuth ───────────────────────────────────────────────────────────────────
# Public base URL of this service — used in OAuth metadata & WWW-Authenticate header
OAUTH_ISSUER=https://api.example.com

# Static client ID for Claude Web (claude.ai). Enter this same value in the
# Claude.ai MCP settings under "OAuth Client ID". Any string works — treat it
# like a username for the app itself (not a user). Leave unset if not using Claude Web.
OAUTH_CLIENT_ID=cp-legal-claude-web

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=warn
NODE_ENV=production
