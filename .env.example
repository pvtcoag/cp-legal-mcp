# ─── Auth ────────────────────────────────────────────────────────────────────
# Legacy / bootstrap tokens. On first boot these are migrated into the users
# table in Postgres; after that, the DB is the source of truth and this env
# var becomes a fallback only used during the startup warm-up window.
# Format: comma-separated user:token pairs. Generate tokens with:
#   openssl rand -base64 32
MCP_AUTH_TOKENS=admin:TOKEN_ADMIN,analyst:TOKEN_ANALYST

# Comma-separated users permitted to use admin tools (inspect_database etc.)
ADMIN_USERS=admin

# ─── AusLaw MCP upstream ─────────────────────────────────────────────────────
# In Railway use the reference variable: http://${{auslaw-mcp.RAILWAY_PRIVATE_DOMAIN}}:3000
AUSLAW_BASE_URL=http://localhost:3000
AUSLAW_TIMEOUT_MS=30000

# ─── Isaacus (legal AI reranking + QA) ───────────────────────────────────────
# REQUIRED — the server will refuse to start without this set.
# Get a key at https://platform.isaacus.com/
ISAACUS_API_KEY=

# ─── Matter tracking (PostgreSQL) ────────────────────────────────────────────
# In Railway use the reference variable: ${{Postgres.DATABASE_URL}}
# Leave unset to disable matter tracking (service continues to work without it,
# though user auth will then rely on MCP_AUTH_TOKENS only).
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# ─── Matter history UI ───────────────────────────────────────────────────────
# Optional: sign session cookies with a stable secret. If unset, falls back to
# MCP_AUTH_TOKENS (sessions invalidated whenever tokens change — acceptable).
# Generate with: openssl rand -base64 32
# SESSION_SECRET=

# Optional default applied when a tool call arrives with no matter_ref.
# Useful if you want every untagged query grouped under a single bucket.
# DEFAULT_MATTER_REF=general-research

# ─── OAuth ───────────────────────────────────────────────────────────────────
# Public base URL of this service (no trailing slash). Used as the issuer in
# OAuth discovery endpoints and the WWW-Authenticate realm.
OAUTH_ISSUER=https://mcp.example.com/auslaw

# Static client ID + optional secret for Claude Web (claude.ai) and ChatGPT
# connectors. The ID is a stable identifier users paste into client config.
# Leave the ID unset if you don't use either.
# OAUTH_CLIENT_ID=cp-legal-claude-web
# OAUTH_CLIENT_SECRET=

# ─── Encryption ──────────────────────────────────────────────────────────────
# REQUIRED for the OAuth token-exchange flow — access tokens are stored
# encrypted in the DB and decrypted during /oauth/token. Must be at least
# 32 characters. Generate with: openssl rand -base64 48
ENCRYPTION_KEY=

# ─── Recovery ────────────────────────────────────────────────────────────────
# Optional recovery token for admin access via the login page when other
# credentials are unavailable. Remove this env var once you've regained access.
# Generate with: openssl rand -base64 48
# RECOVERY_TOKEN=

# ─── ABR (Australian Business Register) ──────────────────────────────────────
# Optional GUID for entity lookups via the ABR Web Services API. Without this,
# lookup_entity falls back to ASIC Connect search URLs only.
# Free registration: https://abr.business.gov.au/Tools/WebServices
# ABR_GUID=

# ─── Debug ───────────────────────────────────────────────────────────────────
# Optional shared secret for /oauth/debug. Protects the diagnostic listing of
# registered OAuth clients. Generate with: openssl rand -base64 32
# DEBUG_SECRET=

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=warn
NODE_ENV=production
