# Bearer token auth — set this to protect the /mcp endpoint (any strong random string)
# Leave unset to disable auth (not recommended in production)
# MCP_AUTH_TOKEN=your-secret-token-here

# AusLaw MCP upstream (Railway private network URL)
# In Railway dashboard use: http://${{auslaw-mcp.RAILWAY_PRIVATE_DOMAIN}}:3000
AUSLAW_BASE_URL=http://localhost:3000
AUSLAW_TIMEOUT_MS=30000

# HuggingFace Inference API
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_ENABLED=true
HF_RERANK_MODEL=isaacus/emubert
HF_RERANK_TOP_K=10

# Server
PORT=8080
LOG_LEVEL=info
NODE_ENV=production
